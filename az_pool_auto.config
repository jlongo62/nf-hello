params {
    azure_tenant_id = 'TBD'
    azure_service_principal_id = 'TBD'
    azure_service_principal_secret = 'TBD'
    azure_batch_account_name = 'TBD'
    azure_batch_endpoint = 'TBD'
    azure_location = 'TBD'
    azure_storage_account_name = 'TBD'
    azure_storage_container = 'TBD'
    azure_machine_type = 'TBD'
    azure_cpus = 'TBD'
    azure_memory = 'TBD'
    azure_allow_pool_creation = true
    azure_auto_pool_mode = true
    azure_delete_pools_on_completion = true
}

profiles {
    az_pool_auto {

        params {
            azure_tenant_id = 'TBD'
            azure_service_principal_id = 'TBD'
            azure_service_principal_secret = 'TBD'
            azure_batch_account_name = 'TBD'
            azure_batch_endpoint = 'TBD'
            azure_location = 'TBD'
            azure_storage_account_name = 'TBD'
            azure_storage_container = 'TBD'
            azure_machine_type = 'TBD'
            azure_cpus = 'TBD'
            azure_memory = 'TBD'
            azure_allow_pool_creation = true
            azure_auto_pool_mode = true
            azure_delete_pools_on_completion = true
        }

        plugins {
            id 'nf-azure'
        }

        process {
            executor = 'azurebatch'
            container = 'quay.io/nextflow/bash'
            machineType = params.azure_machine_type
            cpus = 1
            memory = 1.GB
        }

        workDir = "az://${params.azure_storage_container}"

        azure {
            activeDirectory {
                tenantId = params.azure_tenant_id
                servicePrincipalId = params.azure_service_principal_id
                servicePrincipalSecret = params.azure_service_principal_secret
            }

            batch {
                accountName = params.azure_batch_account_name
                endpoint = params.azure_batch_endpoint
                location = params.azure_location
                allowPoolCreation = params.azure_allow_pool_creation
                autoPoolMode = params.azure_auto_pool_mode
                deletePoolsOnCompletion = params.azure_delete_pools_on_completion
                }

            storage {
                accountName = params.azure_storage_account_name
            }
}
    }
}
