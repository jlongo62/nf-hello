params {
    sleep = 5
}

profiles {
    docker {
        env {
            SLEEP = 5
        }        

        process.container = 'quay.io/nextflow/bash'
        executor {
            queueSize = 2
        }
    }
    docker_secret {
        env {
            SLEEP = secrets.SLEEP
        }
        docker.enabled = true
        process.container = 'quay.io/nextflow/bash'
        executor {
            queueSize = 2
        }
    }    
}

includeConfig 'az_pool_auto.config'
includeConfig 'aws_batch.config'
