params {
    sleep = 5
}

profiles {
    docker {
        params.sleep = 5
        docker.enabled = true
        process.container = 'quay.io/nextflow/bash'
        executor {
            queueSize = 2
        }
    }
    docker_secret {
        params.sleep = (System.getenv('SLEEP') ?: '5')
        docker.enabled = true
        process.container = 'quay.io/nextflow/bash'
        executor {
            queueSize = 2
        }
    }    
}

includeConfig 'az_pool_auto.config'
includeConfig 'aws_batch.config'
