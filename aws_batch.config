profiles {
    aws_batch {

        plugins {
            id 'nf-amazon'
        }

        params {
            aws_profile = 'terraform'
            aws_region = 'us-east-2'
            aws_batch_queue = 'nf-aws-dev-compute'
            aws_work_dir = 's3://nfawsdev-nextflow-work-20260914223108323400000001/nextflow'
            container = 'python:3.12'
        }

        aws {
            profile = "${params.aws_profile ?: 'terraform'}"
            region = "${params.aws_region ?: 'us-east-2'}"
            batch {  
                jobRole = 'arn:aws:iam::733316173060:role/nf-aws-dev-nextflow-job'  
                //critical; tied to creation of pool
                cliPath = '/opt/nextflow/bin/aws'
                // see modules/nf-aws-batch/launch_template.tf

            }
                      
        }

        process {
            executor = 'awsbatch'
            queue = "${params.aws_batch_queue ?: 'nf-aws-dev-compute'}"
            container = "${params.container ?: 'python:3.12'}"
            containerOptions = '--user 0:0'
        }

        workDir = params.aws_work_dir
    }
}
